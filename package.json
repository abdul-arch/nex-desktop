{
  "name": "nex-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rust": "cargo test --workspace",
    "check": "tsc --noEmit && vitest run && cargo test --workspace",
    "backend": "cargo run -p nex-backend",
    "audit": "npm audit && cargo audit",
    "tauri": "tauri",
    "measure": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/measure-memory.ps1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2",
    "lucide-react": "^1.70.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
