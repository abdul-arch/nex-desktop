    "allow-recent-searches-clear",
    "allow-static-data-version",
    "allow-static-catalog",
    "allow-open-external",
    "allow-backend-health",
    "allow-player-profile",
    "allow-player-matches",
    "allow-match-get",
    "allow-match-timeline",
    "allow-stats-meta",
    "allow-stats-tierlist",
    "allow-stats-build",
