{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay-window",
  "description": "Fenetre d'overlay : lecture de l'instantane de partie, de la selection des champions, du catalogue, des sorts du champion, des builds et des statistiques agregees ; disposition de ses propres widgets. Aucun import vers le client, aucune donnee de joueur.",
  "windows": ["overlay"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-settings-get",
    "allow-static-data-version",
    "allow-static-catalog",
    "allow-stats-build",
    "allow-stats-tierlist",
    "allow-stats-matchups",
    "allow-client-champ-select",
    "allow-champion-info",
    "allow-stats-winprob",
    "allow-live-snapshot",
    "allow-loading-roster",
    "allow-ranks-bulk",
    "allow-overlay-set-mode",
    "allow-overlay-mode",
    "allow-overlay-layout-get",
    "allow-overlay-layout-set",
    "allow-mayhem-state"
  ]
}
